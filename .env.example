# Template for pnpm env:local. Generated local values stay in .env.local.
# Inject only each process's allow-listed keys; never copy API secrets to Web.
# Blank secrets/URLs are required from local generation or the secret store.
# Provider credentials are required only by the selected real adapter.
# See specs/_foundation/architecture.md for configuration ownership.

# --- General ---
NODE_ENV=development
APP_ENV=local
APP_BASE_URL=http://localhost:3000
# Web-server-only upstream; the browser uses the constant /api path.
API_INTERNAL_ORIGIN=http://localhost:3001
# API origin allow-list and process ports.
WEB_ORIGIN=http://localhost:3000
PORT=3001
WORKER_PROBE_PORT=3002
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
JOB_RETRY_LIMIT=3
JOB_RETRY_DELAY_MS=1000
IDEMPOTENCY_LEASE_MS=30000
RUNTIME_CLEANUP_INTERVAL_MS=60000
RUNTIME_CLEANUP_BATCH_SIZE=100
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=10
OUTBOX_RELAY_LEASE_MS=30000
# Retry-After (seconds, 1-60) on 503 MAINTENANCE responses.
MAINTENANCE_RETRY_AFTER_SECONDS=30

# --- PostgreSQL (API/worker runtime role only) ---
DATABASE_URL=
CURSOR_SIGNING_KEY=
# Dedicated 32-byte lowercase-hex secret; preserve for retained idempotency records.
IDEMPOTENCY_HASH_KEY=

# --- Migration/seed launcher only; never inject into API/worker/Web ---
MIGRATION_DATABASE_URL=
SHADOW_DATABASE_URL=
# Local Compose only; generated alongside MIGRATION_DATABASE_URL.
POSTGRES_PASSWORD=

# --- Auth / sessions ---
# Independent 32-byte lowercase-hex keys; never reuse or silently rotate.
PII_ENCRYPTION_KEY=
PHONE_LOOKUP_HASH_KEY=
OTP_HASH_KEY=
# Cookie name is fixed: __Host-apnatown_session on HTTPS, apnatown_session on loopback HTTP.
# Positive lifetime required by Auth; local/test launcher supplies a fixture value.
ANONYMOUS_SESSION_TTL_SECONDS=
SESSION_TTL_SECONDS=
OTP_TTL_SECONDS=
OTP_MAX_ATTEMPTS=
OTP_PHONE_REQUESTS_PER_HOUR=
# private-local writes only to ignored .local/otp (0700/0600), never logs or HTTP.
# Production requires an implemented real adapter; 'unavailable' fails API startup there.
OTP_DELIVERY_ADAPTER=unavailable

# --- Consent (users) ---
# TODO(verify): approved consent notice version (Q-31 legal copy).
# Blank keeps consent grants unavailable; withdrawals always work.
CONSENT_NOTICE_VERSION=

# --- Data requests (users export/deletion) ---
# TODO(verify): Q-32 export retention, deletion policy version and completion
# capability lifetime. Blank keeps requests blocked with POLICY_PENDING.
DATA_EXPORT_TTL_SECONDS=
DATA_DELETION_POLICY_VERSION=
DATA_DELETION_COMPLETION_TTL_SECONDS=
# Private generated artifacts (exports); never public URLs or web assets.
# TODO(verify): no production provider chosen; 'unavailable' blocks storage.
# private-local (local/test only) needs an absolute, owner-only directory path.
PRIVATE_STORAGE_ADAPTER=unavailable
PRIVATE_STORAGE_LOCAL_DIR=

# --- SMS / OTP provider (not yet chosen) ---
# TODO(verify): set provider name + credentials once chosen
SMS_OTP_PROVIDER=
SMS_OTP_API_KEY=
SMS_OTP_SENDER_ID=

# --- WhatsApp Business (not yet chosen) ---
# TODO(verify): set BSP name + credentials once chosen
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- Email ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@apnatown.in

# --- Payments (not yet chosen) ---
# TODO(verify): set gateway name + credentials once chosen
PAYMENTS_PROVIDER=
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=

# --- Storage (media uploads) ---
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Maps / geo ---
MAPS_PROVIDER=
MAPS_API_KEY=

# --- Feature flags ---
FEATURE_FLAGS_SOURCE=local
