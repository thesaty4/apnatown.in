# Template for pnpm env:local. Generated local values stay in .env.local.
# Inject only each process's allow-listed keys; never copy API secrets to Web.
# Blank secrets/URLs are required from local generation or the secret store.
# Provider credentials are required only by the selected real adapter.
# See specs/_foundation/architecture.md for configuration ownership.

# --- General ---
NODE_ENV=development
APP_ENV=local
APP_BASE_URL=http://localhost:3000
# Web-server-only upstream; the browser uses the constant /api path.
API_INTERNAL_ORIGIN=http://localhost:3001
# API origin allow-list and process ports.
WEB_ORIGIN=http://localhost:3000
PORT=3001
WORKER_PROBE_PORT=3002
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
JOB_RETRY_LIMIT=3
JOB_RETRY_DELAY_MS=1000
IDEMPOTENCY_LEASE_MS=30000
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=10
OUTBOX_RELAY_LEASE_MS=30000

# --- PostgreSQL (API/worker runtime role only) ---
DATABASE_URL=
CURSOR_SIGNING_KEY=

# --- Migration/seed launcher only; never inject into API/worker/Web ---
MIGRATION_DATABASE_URL=
SHADOW_DATABASE_URL=
# Local Compose only; generated alongside MIGRATION_DATABASE_URL.
POSTGRES_PASSWORD=

# --- Auth / sessions ---
SESSION_COOKIE_SECRET=
SESSION_COOKIE_NAME=apnatown_session
# Positive lifetime required by Auth; local/test launcher supplies a fixture value.
ANONYMOUS_SESSION_TTL_SECONDS=

# --- SMS / OTP provider (not yet chosen) ---
# TODO(verify): set provider name + credentials once chosen
SMS_OTP_PROVIDER=
SMS_OTP_API_KEY=
SMS_OTP_SENDER_ID=

# --- WhatsApp Business (not yet chosen) ---
# TODO(verify): set BSP name + credentials once chosen
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- Email ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@apnatown.in

# --- Payments (not yet chosen) ---
# TODO(verify): set gateway name + credentials once chosen
PAYMENTS_PROVIDER=
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=

# --- Storage (media uploads) ---
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Maps / geo ---
MAPS_PROVIDER=
MAPS_API_KEY=

# --- Feature flags ---
FEATURE_FLAGS_SOURCE=local
