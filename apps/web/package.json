{
  "name": "@apnatown/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "i18n:generate": "node ../../packages/ui/scripts/generate-i18n.mjs",
