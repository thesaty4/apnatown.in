generator client {
  provider        = "prisma-client"
  output          = "../src/shared/persistence/generated"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Owner read foundations for EX1–EX12. SQL migrations own checks, public views
// and expression indexes. There are deliberately no discovery write endpoints.
model Product {
  id String @id @db.Uuid
  businessId String @map("business_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  subcategoryId String @map("subcategory_id") @db.Uuid
  slug String @unique
  nameEn String @map("name_en")
  nameHi String? @map("name_hi")
  description String?
  brand String?
  sku String?
  pricePaise BigInt @map("price_paise")
  mrpPaise BigInt @map("mrp_paise")
  unit String
  tags String[] @default([])
  specs Json @default("[]")
  taxCode String? @map("tax_code")
  featuredSelected Boolean @default(false) @map("featured_selected")
  published Boolean @default(true)
  media Json @default("[]")
  version Int @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  business Business @relation(fields:[businessId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  category Category @relation(fields:[categoryId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  subcategory Subcategory @relation(fields:[subcategoryId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  inventory Inventory?
  offerTargets OfferTarget[]
  variants ProductVariant[]
  cartLines CartLine[]
  @@unique([businessId,sku],where:raw("sku IS NOT NULL"),map:"products_business_sku_key")
  @@index([businessId,createdAt(sort:Desc),id(sort:Desc)],map:"products_business_page_idx")
  @@index([categoryId,subcategoryId,pricePaise,id],where:raw("published AND deleted_at IS NULL"),map:"products_taxonomy_price_idx")
  @@index([subcategoryId],map:"products_subcategory_idx")
  @@index([categoryId,featuredSelected(sort:Desc),createdAt(sort:Desc),id(sort:Desc)],where:raw("published AND deleted_at IS NULL"),map:"products_featured_page_idx")
  @@index([brand,id],where:raw("published AND deleted_at IS NULL"),map:"products_brand_idx")
  @@index([nameEn(ops:raw("gin_trgm_ops")),nameHi(ops:raw("gin_trgm_ops"))],type:Gin,map:"products_names_trgm_idx")
  @@map("products")
}
model Inventory {
  productId String @id @map("product_id") @db.Uuid
  onHand Int @map("on_hand")
  lowStockThreshold Int @default(5) @map("low_stock_threshold")
  availableForSale Boolean @default(true) @map("available_for_sale")
  version Int @default(1)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  product Product @relation(fields:[productId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@index([availableForSale,onHand,productId],map:"inventory_available_idx")
  @@map("inventory")
}
/// Selectable product variant labels (Q-44); deactivated, never hard-deleted.
model ProductVariant {
  id        String  @id @db.Uuid
  productId String  @map("product_id") @db.Uuid
  label     String
  position  Int
  active    Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_variants_product_id_fkey")
  cartLines CartLine[]

  @@unique([productId, label], where: raw("active"), map: "product_variants_active_label_key")
  @@unique([productId, position], where: raw("active"), map: "product_variants_active_position_key")
  @@index([productId, active, position], map: "product_variants_product_order_idx")
  @@map("product_variants")
}

/// Owner customer-facing product pill preferences; taxonomy is never written.
model ProductCategoryPill {
  businessId    String      @map("business_id") @db.Uuid
  subcategoryId String      @map("subcategory_id") @db.Uuid
  position      Int
  labelEn       String?     @map("label_en")
  labelHi       String?     @map("label_hi")
  hidden        Boolean     @default(false)
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_category_pills_business_id_fkey")
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_category_pills_subcategory_id_fkey")

  @@id([businessId, subcategoryId], map: "product_category_pills_pkey")
  @@unique([businessId, position], map: "product_category_pills_business_position_key")
  @@index([subcategoryId], map: "product_category_pills_subcategory_idx")
  @@map("product_category_pills")
}
model Service {
  id String @id @db.Uuid
  businessId String @map("business_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  subcategoryId String @map("subcategory_id") @db.Uuid
  slug String @unique
  nameEn String @map("name_en")
  nameHi String? @map("name_hi")
  description String?
  priceType String @map("price_type")
  priceFromPaise BigInt? @map("price_from_paise")
  priceToPaise BigInt? @map("price_to_paise")
  unit String?
  included String[] @default([])
  excluded String[] @default([])
  serviceArea String? @map("service_area")
  experienceYears Int? @map("experience_years")
  media Json @default("[]")
  galleryVisible Boolean @map("gallery_visible")
  faqs Json @default("[]")
  featuredSelected Boolean @default(false) @map("featured_selected")
  status String @default("active")
  version Int @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  business Business @relation(fields:[businessId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  category Category @relation(fields:[categoryId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  subcategory Subcategory @relation(fields:[subcategoryId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  offerTargets OfferTarget[]
  enquiries Enquiry[]
  @@index([businessId,status,createdAt(sort:Desc),id(sort:Desc)],map:"services_business_page_idx")
  @@index([businessId,createdAt(sort:Desc),id(sort:Desc)],where:raw("deleted_at IS NULL"),map:"services_owner_page_idx")
  @@index([categoryId,subcategoryId,priceFromPaise,id],where:raw("status='active' AND deleted_at IS NULL"),map:"services_taxonomy_price_idx")
  @@index([subcategoryId,businessId],map:"services_subcategory_idx")
  @@index([categoryId,featuredSelected(sort:Desc),createdAt(sort:Desc),id(sort:Desc)],where:raw("status='active' AND deleted_at IS NULL"),map:"services_featured_page_idx")
  @@index([nameEn(ops:raw("gin_trgm_ops")),nameHi(ops:raw("gin_trgm_ops"))],type:Gin,map:"services_names_trgm_idx")
  @@map("services")
}
model Review {
  id String @id @db.Uuid
  targetType String @map("target_type")
  targetId String @map("target_id") @db.Uuid
  businessId String? @map("business_id") @db.Uuid
  authorUserId String @map("author_user_id") @db.Uuid
  eligibilityRefType String @map("eligibility_ref_type")
  eligibilityRefId String @map("eligibility_ref_id") @db.Uuid
  eligibilityPolicyVersion String? @map("eligibility_policy_version")
  rating Int @db.SmallInt
  text String
  tags String[] @default([])
  photoAssetIds String[] @default([]) @map("photo_asset_ids") @db.Uuid
  status String
  moderationReason String? @map("moderation_reason")
  helpfulCount Int @default(0) @map("helpful_count")
  ownerReply String? @map("owner_reply")
  ownerRepliedAt DateTime? @map("owner_replied_at") @db.Timestamptz(6)
  version Int @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  business Business? @relation(fields:[businessId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  author User @relation(fields:[authorUserId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@index([targetType,targetId,rating,id],where:raw("status='published' AND deleted_at IS NULL"),map:"reviews_public_rating_idx")
  @@index([businessId,status,createdAt(sort:Desc),id(sort:Desc)],map:"reviews_business_idx")
  @@index([authorUserId,createdAt(sort:Desc),id(sort:Desc)],map:"reviews_author_idx")
  @@index([targetType,targetId,createdAt(sort:Desc),id(sort:Desc)],where:raw("status IN ('published','reported') AND deleted_at IS NULL"),map:"reviews_public_recent_idx")
  @@index([targetType,targetId,helpfulCount(sort:Desc),createdAt(sort:Desc),id(sort:Desc)],where:raw("status IN ('published','reported') AND deleted_at IS NULL"),map:"reviews_public_helpful_idx")
  @@map("reviews")
}
model BillingPurchase {
  id String @id @db.Uuid
  businessId String @map("business_id") @db.Uuid
  initiatedBy String @map("initiated_by") @db.Uuid
  kind String
  targetKey String @map("target_key")
  preparedPlacementId String? @map("prepared_placement_id") @db.Uuid
  amountPaise BigInt @map("amount_paise")
  configurationVersion String @map("configuration_version")
  configurationSnapshot Json @map("configuration_snapshot")
  periodSnapshot Json @map("period_snapshot")
  status String
  idempotencyKey String @map("idempotency_key")
  requestHash String @map("request_hash")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  business Business @relation(fields:[businessId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  initiator User @relation(fields:[initiatedBy],references:[id],onDelete:NoAction,onUpdate:NoAction)
  preparedPlacement PromotionPlacement? @relation("PreparedPlacement",fields:[preparedPlacementId],references:[id],onDelete:NoAction,onUpdate:NoAction,map:"billing_purchases_prepared_placement_fk")
  placement PromotionPlacement? @relation("PlacementPurchase")
  subscription BusinessSubscription?
  @@unique([initiatedBy,idempotencyKey])
  @@index([businessId,createdAt(sort:Desc),id(sort:Desc)],map:"billing_purchases_business_idx")
  @@index([preparedPlacementId],map:"billing_purchases_placement_idx")
  @@map("billing_purchases")
}
model BusinessSubscriptionVersion {
  businessId String @id @map("business_id") @db.Uuid
  version Int @default(1)
  business Business @relation(fields:[businessId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@map("business_subscription_versions")
}
model BusinessSubscription {
  id String @id @db.Uuid
  businessId String @map("business_id") @db.Uuid
  planKey String @map("plan_key")
  purchaseId String? @unique @map("purchase_id") @db.Uuid
  planSnapshot Json? @map("plan_snapshot")
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(6)
  cancellationRequestedAt DateTime? @map("cancellation_requested_at") @db.Timestamptz(6)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  business Business @relation(fields:[businessId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  purchase BillingPurchase? @relation(fields:[purchaseId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@index([businessId,startsAt,endsAt,id],map:"business_subscriptions_period_idx")
  @@map("business_subscriptions")
}
model Offer {
  id String @id @db.Uuid
  businessId String @map("business_id") @db.Uuid
  titleEn String @map("title_en")
  titleHi String? @map("title_hi")
  termsEn String? @map("terms_en")
  termsHi String? @map("terms_hi")
  discountType String @map("discount_type")
  discountPercent Int? @map("discount_percent") @db.SmallInt
  discountPaise BigInt? @map("discount_paise")
  scope String
  validFrom DateTime @map("valid_from") @db.Timestamptz(6)
  validTo DateTime @map("valid_to") @db.Timestamptz(6)
  status String @default("pending")
  reviewDecision String? @map("review_decision")
  reviewedBy String? @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  firstApprovedAt DateTime? @map("first_approved_at") @db.Timestamptz(6)
  rejectionReason String? @map("rejection_reason")
  featured Boolean @default(false)
  bannerAssetId String? @map("banner_asset_id") @db.Uuid
  viewsCount BigInt @default(0) @map("views_count")
  usesCount BigInt @default(0) @map("uses_count")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  business Business @relation(fields:[businessId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  reviewer User? @relation(fields:[reviewedBy],references:[id],onDelete:NoAction,onUpdate:NoAction)
  banner MediaAsset? @relation(fields:[bannerAssetId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  targets OfferTarget[]
  @@index([businessId,validFrom,validTo,id],where:raw("status='active' AND review_decision='approved'"),map:"offers_public_idx")
  @@index([reviewedBy],map:"offers_reviewer_idx")
  @@index([bannerAssetId],map:"offers_banner_idx")
  @@map("offers")
}
model OfferTarget {
  id String @id @db.Uuid
  offerId String @map("offer_id") @db.Uuid
  targetKind String @map("target_kind")
  productId String? @map("product_id") @db.Uuid
  serviceId String? @map("service_id") @db.Uuid
  offer Offer @relation(fields:[offerId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  product Product? @relation(fields:[productId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  service Service? @relation(fields:[serviceId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@unique([offerId,productId],where:raw("product_id IS NOT NULL"),map:"offer_targets_product_key")
  @@unique([offerId,serviceId],where:raw("service_id IS NOT NULL"),map:"offer_targets_service_key")
  @@index([productId,offerId],map:"offer_targets_product_idx")
  @@index([serviceId,offerId],map:"offer_targets_service_idx")
  @@map("offer_targets")
}
model PromotionPlacement {
  id String @id @db.Uuid
  kind String
  surface String
  source String
  businessId String? @map("business_id") @db.Uuid
  purchaseId String? @unique @map("purchase_id") @db.Uuid
  promotionKey String? @map("promotion_key")
  scopeKind String @map("scope_kind")
  cityId String? @map("city_id") @db.Uuid
  areaId String? @map("area_id") @db.Uuid
  titleEn String? @map("title_en")
  titleHi String? @map("title_hi")
  subtitleEn String? @map("subtitle_en")
  subtitleHi String? @map("subtitle_hi")
  bannerAssetId String? @map("banner_asset_id") @db.Uuid
  destination Json?
  position Int @default(0)
  status String @default("draft")
  startsAt DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(6)
  configurationVersion String? @map("configuration_version")
  activationBlockedReason String? @map("activation_blocked_reason")
  createdBy String @map("created_by") @db.Uuid
  updatedBy String @map("updated_by") @db.Uuid
  version Int @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  business Business? @relation(fields:[businessId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  purchase BillingPurchase? @relation("PlacementPurchase",fields:[purchaseId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  preparedPurchases BillingPurchase[] @relation("PreparedPlacement")
  city City? @relation(fields:[cityId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  area Area? @relation(fields:[areaId,cityId],references:[id,cityId],onDelete:NoAction,onUpdate:NoAction)
  banner MediaAsset? @relation(fields:[bannerAssetId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  creator User @relation("PlacementCreator",fields:[createdBy],references:[id],onDelete:NoAction,onUpdate:NoAction)
  updater User @relation("PlacementUpdater",fields:[updatedBy],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@index([businessId,status,startsAt,endsAt,id],map:"promotion_placements_business_idx")
  @@index([cityId,areaId,status,position,id],map:"promotion_placements_scope_idx")
  @@index([areaId,cityId],map:"promotion_placements_area_idx")
  @@index([createdBy],map:"promotion_placements_creator_idx")
  @@index([updatedBy],map:"promotion_placements_updater_idx")
  @@index([bannerAssetId],map:"promotion_placements_banner_idx")
  @@map("promotion_placements")
}

model OutboxEvent {
  id               String    @id @db.Uuid
  type             String
  schemaVersion    Int       @default(1) @map("schema_version")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  payload          Json      @db.JsonB
  correlationId    String    @map("correlation_id")
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  availableAt      DateTime  @map("available_at") @db.Timestamptz(6)
  state            String    @default("pending")
  attemptCount     Int       @default(0) @map("attempt_count")
  leaseOwner       String?   @map("lease_owner")
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  lastErrorCode    String?   @map("last_error_code")

  @@index([state, availableAt, id], map: "outbox_events_state_available_at_id_idx")
  @@index([leaseExpiresAt, id], where: raw("\"state\" = 'publishing'"), map: "outbox_events_lease_expires_at_id_idx")
  @@index([aggregateType, aggregateId, aggregateVersion], map: "outbox_events_aggregate_idx")
  @@map("outbox_events")
}

model IdempotencyKey {
  id              String    @id @db.Uuid
  principalKey    String    @map("principal_key")
  operation       String
  keyHash         Bytes     @map("key_hash")
  requestHash     Bytes     @map("request_hash")
  state           String
  leaseOwner      String?   @map("lease_owner")
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  httpStatus      Int?      @map("http_status")
  responseBody    Json?     @map("response_body") @db.JsonB
  responseHeaders Json      @default("{}") @map("response_headers") @db.JsonB
  resourceRef     Json?     @map("resource_ref") @db.JsonB
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)

  @@unique([principalKey, operation, keyHash], map: "idempotency_keys_principal_operation_key_hash_key")
  @@index([expiresAt, id], map: "idempotency_keys_expires_at_id_idx")
  @@index([state, leaseExpiresAt], map: "idempotency_keys_state_lease_expires_at_idx")
  @@map("idempotency_keys")
}

model RateLimitBucket {
  policyKey   String   @map("policy_key")
  subjectHash Bytes    @map("subject_hash")
  bucketStart DateTime @map("bucket_start") @db.Timestamptz(6)
  hitCount    BigInt   @default(0) @map("hit_count")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([policyKey, subjectHash, bucketStart])
  @@index([expiresAt], map: "rate_limit_buckets_expires_at_idx")
  @@map("rate_limit_buckets")
}

model User {
  bookmarks Bookmark[]
  authoredReviews Review[]
  billingPurchases BillingPurchase[]
  reviewedOffers Offer[]
  createdPlacements PromotionPlacement[] @relation("PlacementCreator")
  updatedPlacements PromotionPlacement[] @relation("PlacementUpdater")
  id                   String                   @id @db.Uuid
  phoneCiphertext      String?                  @map("phone_ciphertext")
  phoneLookupHash      Bytes?                   @unique(map: "users_phone_lookup_hash_key") @map("phone_lookup_hash")
  emailCiphertext      String?                  @map("email_ciphertext")
  displayName          String?                  @map("display_name")
  preferredLocale      String                   @default("en") @map("preferred_locale")
  themePreference      String                   @default("light") @map("theme_preference")
  accountStatus        String                   @default("active") @map("account_status")
  version              Int                      @default(1)
  deletedAt            DateTime?                @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime                 @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @map("updated_at") @db.Timestamptz(6)
  roles                UserRole[]
  sessions             Session[]
  addresses            Address[]
  consents             Consent[]
  dataRequests         DataRequest[]
  auditLogs            AuditLog[]
  adminAccount         AdminAccount?            @relation("AdminAccountUser")
  adminsCreated        AdminAccount[]           @relation("AdminAccountCreator")
  settingsUpdated      Setting[]
  flagsUpdated         FeatureFlag[]
  legalUpdated         LegalPage[]
  supportMessages      SupportMessage[]
  homeSectionsCreated  CatalogHomeSection[]     @relation("CatalogHomeSectionCreator")
  homeSectionsUpdated  CatalogHomeSection[]     @relation("CatalogHomeSectionUpdater")
  suggestionsSubmitted SubcategorySuggestion[]  @relation("SuggestionSubmitter")
  suggestionsReviewed  SubcategorySuggestion[]  @relation("SuggestionReviewer")
  businessesOwned      Business[]               @relation("BusinessOwner")
  businessesReviewed   Business[]               @relation("BusinessReviewer")
  businessDocuments    BusinessDocument[]
  billingReviewed      BusinessBillingProfile[]
  mediaAssets          MediaAsset[]
  mediaUploads         MediaUploadOperation[]
  reportedMedia        MediaReport[]              @relation("MediaReportReporter")
  videoComments        VideoComment[]
  likes                Like[]
  hearts               Heart[]
  follows              Follow[]
  enquiries            Enquiry[]
  carts                Cart[]
  notifications        Notification[]
  notificationPreference NotificationPreference?
  riderProfile         RiderProfile?            @relation("RiderProfileUser")

  @@index([deletedAt], where: raw("\"deleted_at\" IS NULL"), map: "users_active_deleted_at_idx")
  @@map("users")
}

model Bookmark {
  userId String @map("user_id") @db.Uuid
  targetType String @map("target_type")
  targetId String @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@id([userId,targetType,targetId])
  @@index([userId,targetType,createdAt(sort:Desc),targetId(sort:Desc)],map:"bookmarks_saved_page_idx")
  @@map("bookmarks")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "user_roles_user_id_fkey")

  @@id([userId, role], map: "user_roles_pkey")
  @@index([role, userId], map: "user_roles_role_user_id_idx")
  @@map("user_roles")
}

model Address {
  id          String                                @id @db.Uuid
  userId      String                                @map("user_id") @db.Uuid
  label       String
  addressText String                                @map("address_text")
  landmark    String?
  pinCode     String                                @map("pin_code")
  cityId      String                                @map("city_id") @db.Uuid
  areaId      String?                               @map("area_id") @db.Uuid
  location    Unsupported("geography(Point,4326)")?
  isDefault   Boolean                               @default(false) @map("is_default")
  version     Int                                   @default(1)
  deletedAt   DateTime?                             @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime                              @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                              @map("updated_at") @db.Timestamptz(6)
