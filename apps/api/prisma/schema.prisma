generator client {
  provider        = "prisma-client"
  output          = "../src/shared/persistence/generated"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model OutboxEvent {
  id               String    @id @db.Uuid
  type             String
  schemaVersion    Int       @default(1) @map("schema_version")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  payload          Json      @db.JsonB
  correlationId    String    @map("correlation_id")
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  availableAt      DateTime  @map("available_at") @db.Timestamptz(6)
  state            String    @default("pending")
  attemptCount     Int       @default(0) @map("attempt_count")
  leaseOwner       String?   @map("lease_owner")
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  lastErrorCode    String?   @map("last_error_code")

  @@index([state, availableAt, id], map: "outbox_events_state_available_at_id_idx")
  @@index([leaseExpiresAt, id], where: raw("\"state\" = 'publishing'"), map: "outbox_events_lease_expires_at_id_idx")
  @@index([aggregateType, aggregateId, aggregateVersion], map: "outbox_events_aggregate_idx")
  @@map("outbox_events")
}

model IdempotencyKey {
  id              String    @id @db.Uuid
  principalKey    String    @map("principal_key")
  operation       String
  keyHash         Bytes     @map("key_hash")
  requestHash     Bytes     @map("request_hash")
  state           String
  leaseOwner      String?   @map("lease_owner")
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  httpStatus      Int?      @map("http_status")
  responseBody    Json?     @map("response_body") @db.JsonB
  responseHeaders Json      @default("{}") @map("response_headers") @db.JsonB
  resourceRef     Json?     @map("resource_ref") @db.JsonB
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)

  @@unique([principalKey, operation, keyHash], map: "idempotency_keys_principal_operation_key_hash_key")
  @@index([expiresAt, id], map: "idempotency_keys_expires_at_id_idx")
  @@index([state, leaseExpiresAt], map: "idempotency_keys_state_lease_expires_at_idx")
  @@map("idempotency_keys")
}

model RateLimitBucket {
  policyKey   String   @map("policy_key")
  subjectHash Bytes    @map("subject_hash")
  bucketStart DateTime @map("bucket_start") @db.Timestamptz(6)
  hitCount    BigInt   @default(0) @map("hit_count")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([policyKey, subjectHash, bucketStart])
  @@index([expiresAt], map: "rate_limit_buckets_expires_at_idx")
  @@map("rate_limit_buckets")
}

model User {
  id                   String                  @id @db.Uuid
  phoneCiphertext      String?                 @map("phone_ciphertext")
  phoneLookupHash      Bytes?                  @unique(map: "users_phone_lookup_hash_key") @map("phone_lookup_hash")
  emailCiphertext      String?                 @map("email_ciphertext")
  displayName          String?                 @map("display_name")
  preferredLocale      String                  @default("en") @map("preferred_locale")
  themePreference      String                  @default("light") @map("theme_preference")
  accountStatus        String                  @default("active") @map("account_status")
  version              Int                     @default(1)
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime                @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @map("updated_at") @db.Timestamptz(6)
  roles                UserRole[]
  sessions             Session[]
  addresses            Address[]
  consents             Consent[]
  dataRequests         DataRequest[]
  auditLogs            AuditLog[]
  adminAccount         AdminAccount?           @relation("AdminAccountUser")
  adminsCreated        AdminAccount[]          @relation("AdminAccountCreator")
  settingsUpdated      Setting[]
  flagsUpdated         FeatureFlag[]
  legalUpdated         LegalPage[]
  supportMessages      SupportMessage[]
  homeSectionsCreated  CatalogHomeSection[]    @relation("CatalogHomeSectionCreator")
  homeSectionsUpdated  CatalogHomeSection[]    @relation("CatalogHomeSectionUpdater")
  suggestionsSubmitted SubcategorySuggestion[] @relation("SuggestionSubmitter")
  suggestionsReviewed  SubcategorySuggestion[] @relation("SuggestionReviewer")

  @@index([deletedAt], where: raw("\"deleted_at\" IS NULL"), map: "users_active_deleted_at_idx")
  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "user_roles_user_id_fkey")

  @@id([userId, role], map: "user_roles_pkey")
  @@index([role, userId], map: "user_roles_role_user_id_idx")
  @@map("user_roles")
}

model Address {
  id          String                                @id @db.Uuid
  userId      String                                @map("user_id") @db.Uuid
  label       String
  addressText String                                @map("address_text")
  landmark    String?
  pinCode     String                                @map("pin_code")
  cityId      String                                @map("city_id") @db.Uuid
  areaId      String?                               @map("area_id") @db.Uuid
  location    Unsupported("geography(Point,4326)")?
  isDefault   Boolean                               @default(false) @map("is_default")
  version     Int                                   @default(1)
  deletedAt   DateTime?                             @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime                              @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                              @map("updated_at") @db.Timestamptz(6)
  user        User                                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "addresses_user_id_fkey")
  city        City                                  @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "addresses_city_id_fkey")
  area        Area?                                 @relation(fields: [areaId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: Restrict, map: "addresses_area_city_fkey")

  @@unique([userId], where: raw("\"is_default\" AND \"deleted_at\" IS NULL"), map: "addresses_live_default_key")
  @@index([userId, deletedAt, createdAt(sort: Desc), id(sort: Desc)], map: "addresses_owner_page_idx")
  @@index([cityId], map: "addresses_city_id_idx")
  @@index([areaId, cityId], map: "addresses_area_city_idx")
  @@map("addresses")
}

model Consent {
  id                   String   @id @db.Uuid
  userId               String?  @map("user_id") @db.Uuid
  anonymousSubjectHash Bytes?   @map("anonymous_subject_hash")
  purpose              String
  channel              String?
  granted              Boolean
  noticeVersion        String?  @map("notice_version")
  recordedAt           DateTime @map("recorded_at") @db.Timestamptz(6)
  source               String
  user                 User?    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "consents_user_id_fkey")

  @@index([userId, purpose, channel, recordedAt(sort: Desc), id(sort: Desc)], map: "consents_user_choice_idx")
  @@index([anonymousSubjectHash, purpose, channel, recordedAt(sort: Desc), id(sort: Desc)], map: "consents_anonymous_choice_idx")
  @@map("consents")
}

model DataRequest {
  id                       String    @id @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  requestType              String    @map("request_type")
  status                   String    @default("queued")
  idempotencyKey           String    @map("idempotency_key")
  policyVersion            String?   @map("policy_version")
  completedSteps           Json      @default("{}") @map("completed_steps") @db.JsonB
  artifactStorageKey       String?   @map("artifact_storage_key")
  artifactExpiresAt        DateTime? @map("artifact_expires_at") @db.Timestamptz(6)
  completionTokenHash      Bytes?    @map("completion_token_hash")
  completionTokenExpiresAt DateTime? @map("completion_token_expires_at") @db.Timestamptz(6)
  failureCode              String?   @map("failure_code")
  requestedAt              DateTime  @map("requested_at") @db.Timestamptz(6)
  updatedAt                DateTime  @map("updated_at") @db.Timestamptz(6)
  completedAt              DateTime? @map("completed_at") @db.Timestamptz(6)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_requests_user_id_fkey")

  @@unique([userId, idempotencyKey], map: "data_requests_user_id_idempotency_key_key")
  @@index([userId, requestedAt(sort: Desc), id(sort: Desc)], map: "data_requests_user_requested_idx")
  @@index([status, requestedAt, id], where: raw("\"status\" IN ('queued', 'processing')"), map: "data_requests_work_idx")
  @@map("data_requests")
}

model OtpChallenge {
  id              String    @id @db.Uuid
  phoneCiphertext String    @map("phone_ciphertext")
  phoneLookupHash Bytes     @map("phone_lookup_hash")
  codeHash        String    @map("code_hash")
  attemptCount    Int       @default(0) @map("attempt_count")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  resendAfter     DateTime  @map("resend_after") @db.Timestamptz(6)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  supersededAt    DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)

  @@index([phoneLookupHash, createdAt(sort: Desc)], map: "otp_challenges_phone_created_at_idx")
  @@index([expiresAt], map: "otp_challenges_expires_at_idx")
  @@map("otp_challenges")
}

model Session {
  id         String    @id @db.Uuid
  kind       String
  userId     String?   @map("user_id") @db.Uuid
  tokenHash  Bytes     @unique(map: "sessions_token_hash_key") @map("token_hash")
  csrfToken  String    @map("csrf_token")
  createdAt  DateTime  @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(6)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sessions_user_id_fkey")

  @@index([userId, revokedAt, expiresAt], map: "sessions_user_revoked_expires_at_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model City {
  id          String                  @id @db.Uuid
  slug        String                  @unique(map: "cities_slug_key")
  nameEn      String                  @map("name_en")
  nameHi      String                  @map("name_hi")
  stateCode   String                  @map("state_code") @db.Char(2)
  status      String
  version     Int                     @default(1)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  areas       Area[]
  zones       Zone[]
  waitlist    ServiceAreaWaitlist[]
  addresses   Address[]
  adminScopes AdminScope[]
  support     SupportMessage[]
  suggestions SubcategorySuggestion[]

  @@index([status, nameEn, id], map: "cities_status_name_en_id_idx")
  @@map("cities")
}

model Area {
  id          String                                @id @db.Uuid
  cityId      String                                @map("city_id") @db.Uuid
  slug        String
  nameEn      String                                @map("name_en")
  nameHi      String                                @map("name_hi")
  pinCode     String?                               @map("pin_code")
  centroid    Unsupported("geography(Point,4326)")?
  createdAt   DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                              @default(now()) @map("updated_at") @db.Timestamptz(6)
  city        City                                  @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "areas_city_id_fkey")
  addresses   Address[]
  adminScopes AdminScope[]
  support     SupportMessage[]
  suggestions SubcategorySuggestion[]

  @@unique([id, cityId], map: "areas_id_city_id_key")
  @@unique([cityId, slug], map: "areas_city_slug_key")
  @@index([cityId, nameEn, id], map: "areas_city_name_en_id_idx")
  @@index([cityId, pinCode], map: "areas_city_pin_code_idx")
  @@index([nameEn(ops: raw("gin_trgm_ops")), nameHi(ops: raw("gin_trgm_ops"))], type: Gin, map: "areas_names_trgm_idx")
  @@map("areas")
}

model Zone {
  id        String                                @id @db.Uuid
  cityId    String                                @map("city_id") @db.Uuid
  name      String
  polygon   Unsupported("geometry(Polygon,4326)")
  status    String
  version   Int                                   @default(1)
  createdAt DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                              @default(now()) @map("updated_at") @db.Timestamptz(6)
  city      City                                  @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "zones_city_id_fkey")
  feeSlabs  ZoneFeeSlab[]

  @@index([polygon], type: Gist, map: "zones_polygon_idx")
  @@index([cityId, status], map: "zones_city_status_idx")
  @@index([cityId, name, id], map: "zones_city_name_id_idx")
  @@map("zones")
}

model ZoneFeeSlab {
  zoneId          String   @map("zone_id") @db.Uuid
  sequence        Int      @db.SmallInt
  upperDistanceKm Decimal  @map("upper_distance_km") @db.Decimal(5, 2)
  feePaise        BigInt   @map("fee_paise")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  zone            Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "zone_fee_slabs_zone_id_fkey")

  @@id([zoneId, sequence], map: "zone_fee_slabs_pkey")
  @@unique([zoneId, upperDistanceKm], map: "zone_fee_slabs_zone_distance_key")
  @@map("zone_fee_slabs")
}

model ServiceAreaWaitlist {
  id              String   @id @db.Uuid
  cityId          String?  @map("city_id") @db.Uuid
  phoneCiphertext String   @map("phone_ciphertext")
  phoneLookupHash Bytes    @map("phone_lookup_hash")
  requestedAt     DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  city            City?    @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "service_area_waitlist_city_id_fkey")

  @@index([cityId, requestedAt(sort: Desc)], map: "service_area_waitlist_city_requested_at_idx")
  @@map("service_area_waitlist")
}

/// Append-only (runtime INSERT, SELECT). The GIN full-text expression index
/// `audit_logs_search_idx` lives in the migration only.
model AuditLog {
  id            String   @id @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorRole     String   @map("actor_role")
  actorLabel    String   @map("actor_label")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  cityId        String?  @map("city_id") @db.Uuid
  areaId        String?  @map("area_id") @db.Uuid
  relatedScopes Json     @default("[]") @map("related_scopes") @db.JsonB
  summary       String
  before        Json?    @db.JsonB
  after         Json?    @db.JsonB
  correlationId String   @map("correlation_id")
  ipHash        Bytes?   @map("ip_hash")
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_logs_actor_user_id_fkey")

  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "audit_logs_feed_idx")
  @@index([entityType, entityId, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_logs_entity_history_idx")
  @@index([actorUserId, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_logs_actor_feed_idx")
  @@index([cityId, areaId, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_logs_scope_feed_idx")
  @@map("audit_logs")
}

model Role {
  id          String           @id @db.Uuid
  name        String           @unique(map: "roles_name_key")
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  version     Int              @default(1)
  createdAt   DateTime         @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]
  admins      AdminAccount[]

  @@map("roles")
}

model RolePermission {
  roleId String @map("role_id") @db.Uuid
  module String
  action String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "role_permissions_role_id_fkey")

  @@id([roleId, module, action], map: "role_permissions_pkey")
  @@map("role_permissions")
}

model AdminAccount {
  userId              String            @id @map("user_id") @db.Uuid
  displayName         String            @map("display_name")
  emailCiphertext     String            @map("email_ciphertext")
  roleId              String            @map("role_id") @db.Uuid
  status              String
  communicationScopes String[]          @default([]) @map("communication_scopes")
  lastActiveAt        DateTime?         @map("last_active_at") @db.Timestamptz(6)
  version             Int               @default(1)
  createdBy           String?           @map("created_by") @db.Uuid
  createdAt           DateTime          @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @map("updated_at") @db.Timestamptz(6)
  user                User              @relation("AdminAccountUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "admin_accounts_user_id_fkey")
  role                Role              @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "admin_accounts_role_id_fkey")
  creator             User?             @relation("AdminAccountCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "admin_accounts_created_by_fkey")
  permissions         AdminPermission[]
  scopes              AdminScope[]

  @@index([roleId], map: "admin_accounts_role_id_idx")
  @@index([status], map: "admin_accounts_status_idx")
  @@index([createdAt(sort: Desc), userId(sort: Desc)], map: "admin_accounts_created_page_idx")
  @@map("admin_accounts")
}

model AdminPermission {
  userId  String       @map("user_id") @db.Uuid
  module  String
  action  String
  account AdminAccount @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Restrict, map: "admin_permissions_user_id_fkey")

  @@id([userId, module, action], map: "admin_permissions_pkey")
  @@map("admin_permissions")
}

model AdminScope {
  id        String       @id @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  authority String
  areaId    String?      @map("area_id") @db.Uuid
  cityId    String       @map("city_id") @db.Uuid
  account   AdminAccount @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Restrict, map: "admin_scopes_user_id_fkey")
  city      City         @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "admin_scopes_city_id_fkey")
  area      Area?        @relation(fields: [areaId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: Restrict, map: "admin_scopes_area_city_fkey")

  @@unique([userId, areaId], where: raw("\"authority\" = 'area'"), map: "admin_scopes_area_grant_key")
  @@unique([userId, cityId], where: raw("\"authority\" = 'city'"), map: "admin_scopes_city_grant_key")
  @@index([userId, authority, cityId, areaId], map: "admin_scopes_guard_idx")
  @@index([cityId], map: "admin_scopes_city_id_idx")
  @@index([areaId, cityId], map: "admin_scopes_area_city_idx")
  @@map("admin_scopes")
}

model Setting {
  key       String   @id
  value     Json     @db.JsonB
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  updater   User?    @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "settings_updated_by_fkey")

  @@index([updatedBy], map: "settings_updated_by_idx")
  @@map("settings")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  updater   User?    @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "feature_flags_updated_by_fkey")

  @@index([updatedBy], map: "feature_flags_updated_by_idx")
  @@map("feature_flags")
}

model LegalPage {
  slug        String   @id
  titleEn     String   @map("title_en")
  titleHi     String   @map("title_hi")
  bodyEn      String   @map("body_en")
  bodyHi      String   @map("body_hi")
  version     Int      @default(1)
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid
  updater     User?    @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "legal_pages_updated_by_fkey")

  @@index([updatedBy], map: "legal_pages_updated_by_idx")
  @@map("legal_pages")
}

model SupportMessage {
  id        String   @id @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  message   String
  source    String
  sourceKey String?  @map("source_key")
  cityId    String?  @map("city_id") @db.Uuid
  areaId    String?  @map("area_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "support_messages_user_id_fkey")
  city      City?    @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "support_messages_city_id_fkey")
  area      Area?    @relation(fields: [areaId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: Restrict, map: "support_messages_area_city_fkey")

  @@unique([source, sourceKey], map: "support_messages_source_key_key")
  @@index([cityId, areaId, createdAt(sort: Desc), id(sort: Desc)], map: "support_messages_scope_feed_idx")
  @@index([userId, createdAt, id], map: "support_messages_user_idx")
  @@index([areaId, cityId], map: "support_messages_area_city_idx")
  @@map("support_messages")
}

// Catalog taxonomy (F-SA-008). `imageAssetId` gains its media_assets FK in
// the Media migration; there is no Prisma relation until then.
model Category {
  id                 String                       @id @db.Uuid
  kind               String
  slug               String                       @unique(map: "categories_slug_key")
  nameEn             String                       @map("name_en")
  nameHi             String                       @map("name_hi")
  icon               String?
  imageAssetId       String?                      @map("image_asset_id") @db.Uuid
  active             Boolean                      @default(true)
  sortOrder          Int                          @default(0) @map("sort_order")
  version            Int                          @default(1)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)
  subcategories      Subcategory[]
  relatedTo          CategoryRelation[]           @relation("CategoryRelationSource")
  relatedFrom        CategoryRelation[]           @relation("CategoryRelationRelated")
  dedicatedSections  CatalogHomeSection[]         @relation("CatalogHomeSectionCategory")
  initialForSections CatalogHomeSection[]         @relation("CatalogHomeSectionInitial")
  sectionPills       CatalogHomeSectionCategory[]
  suggestions        SubcategorySuggestion[]
  keywordTargets     KeywordMappingTarget[]

  @@index([kind, active, sortOrder, id], map: "categories_kind_active_sort_idx")
  @@map("categories")
}

model CategoryRelation {
  sourceCategoryId  String   @map("source_category_id") @db.Uuid
  relatedCategoryId String   @map("related_category_id") @db.Uuid
  sortOrder         Int      @map("sort_order")
  source            Category @relation("CategoryRelationSource", fields: [sourceCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "category_relations_source_fkey")
  related           Category @relation("CategoryRelationRelated", fields: [relatedCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "category_relations_related_fkey")

  @@id([sourceCategoryId, relatedCategoryId], map: "category_relations_pkey")
  @@unique([sourceCategoryId, sortOrder], map: "category_relations_source_sort_key")
  @@index([relatedCategoryId], map: "category_relations_related_idx")
  @@map("category_relations")
}

model Subcategory {
  id             String                  @id @db.Uuid
  categoryId     String                  @map("category_id") @db.Uuid
  slug           String
  nameEn         String                  @map("name_en")
  nameHi         String                  @map("name_hi")
  normalizedName String                  @map("normalized_name")
  serviceTypes   String[]                @default([]) @map("service_types")
  imageAssetId   String?                 @map("image_asset_id") @db.Uuid
  active         Boolean                 @default(true)
  sortOrder      Int                     @default(0) @map("sort_order")
  version        Int                     @default(1)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  category       Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategories_category_id_fkey")
  approvedFrom   SubcategorySuggestion[] @relation("SuggestionApproved")
  mergedFrom     SubcategorySuggestion[] @relation("SuggestionMerged")
  keywordTargets KeywordMappingTarget[]

  @@unique([categoryId, slug], map: "subcategories_category_slug_key")
  @@unique([categoryId, normalizedName], map: "subcategories_category_normalized_name_key")
  @@index([categoryId, active, sortOrder, id], map: "subcategories_category_active_sort_idx")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "subcategories_normalized_name_trgm_idx")
  @@map("subcategories")
}

model CatalogHomeSection {
  id                String                       @id @db.Uuid
  kind              String
  contentKind       String                       @map("content_kind")
  categoryId        String?                      @map("category_id") @db.Uuid
  headingEn         String?                      @map("heading_en")
  headingHi         String?                      @map("heading_hi")
  supportingTextEn  String?                      @map("supporting_text_en")
  supportingTextHi  String?                      @map("supporting_text_hi")
  initialCategoryId String?                      @map("initial_category_id") @db.Uuid
  position          Int
  active            Boolean                      @default(false)
  removedAt         DateTime?                    @map("removed_at") @db.Timestamptz(6)
  version           Int                          @default(1)
  createdBy         String                       @map("created_by") @db.Uuid
  updatedBy         String                       @map("updated_by") @db.Uuid
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)
  category          Category?                    @relation("CatalogHomeSectionCategory", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "catalog_home_sections_category_id_fkey")
  initialCategory   Category?                    @relation("CatalogHomeSectionInitial", fields: [initialCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "catalog_home_sections_initial_category_id_fkey")
  creator           User                         @relation("CatalogHomeSectionCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "catalog_home_sections_created_by_fkey")
  updater           User                         @relation("CatalogHomeSectionUpdater", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "catalog_home_sections_updated_by_fkey")
  categories        CatalogHomeSectionCategory[]

  @@unique([categoryId], where: raw("\"kind\" = 'single_category' AND \"removed_at\" IS NULL"), map: "catalog_home_sections_single_category_key")
  @@index([position, id], where: raw("\"active\""), map: "catalog_home_sections_active_position_idx")
  @@map("catalog_home_sections")
}

model CatalogHomeSectionCategory {
  sectionId  String             @map("section_id") @db.Uuid
  categoryId String             @map("category_id") @db.Uuid
  position   Int
  section    CatalogHomeSection @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "catalog_home_section_categories_section_id_fkey")
  category   Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "catalog_home_section_categories_category_id_fkey")

  @@id([sectionId, categoryId], map: "catalog_home_section_categories_pkey")
  @@unique([sectionId, position], map: "catalog_home_section_categories_section_position_key")
  @@index([sectionId, position, categoryId], map: "catalog_home_section_categories_pills_idx")
  @@index([categoryId, sectionId], map: "catalog_home_section_categories_category_idx")
  @@map("catalog_home_section_categories")
}

// `businessId` gains its businesses FK in the Businesses migration.
model SubcategorySuggestion {
  id                      String       @id @db.Uuid
  businessId              String       @map("business_id") @db.Uuid
  submitterUserId         String       @map("submitter_user_id") @db.Uuid
  cityId                  String       @map("city_id") @db.Uuid
  areaId                  String       @map("area_id") @db.Uuid
  categoryId              String       @map("category_id") @db.Uuid
  nameEn                  String       @map("name_en")
  nameHi                  String?      @map("name_hi")
  normalizedName          String       @map("normalized_name")
  reason                  String?
  status                  String       @default("pending")
  reviewedBy              String?      @map("reviewed_by") @db.Uuid
  reviewedAt              DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason         String?      @map("rejection_reason")
  subcategoryId           String?      @map("subcategory_id") @db.Uuid
  mergedIntoSubcategoryId String?      @map("merged_into_subcategory_id") @db.Uuid
  version                 Int          @default(1)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  submitter               User         @relation("SuggestionSubmitter", fields: [submitterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_submitter_user_id_fkey")
  reviewer                User?        @relation("SuggestionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_reviewed_by_fkey")
  city                    City         @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_city_id_fkey")
  area                    Area         @relation(fields: [areaId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_area_city_fkey")
  category                Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_category_id_fkey")
  subcategory             Subcategory? @relation("SuggestionApproved", fields: [subcategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_subcategory_id_fkey")
  mergedInto              Subcategory? @relation("SuggestionMerged", fields: [mergedIntoSubcategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_merged_into_fkey")

  @@unique([categoryId, normalizedName], where: raw("\"status\" = 'pending'"), map: "subcategory_suggestions_pending_name_key")
  @@index([status, cityId, areaId, createdAt, id], map: "subcategory_suggestions_queue_idx")
  @@index([businessId, createdAt(sort: Desc), id(sort: Desc)], map: "subcategory_suggestions_business_idx")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "subcategory_suggestions_normalized_name_trgm_idx")
  @@index([areaId, cityId], map: "subcategory_suggestions_area_city_idx")
  @@map("subcategory_suggestions")
}

model KeywordMapping {
  id        String                 @id @db.Uuid
  enabled   Boolean                @default(true)
  version   Int                    @default(1)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  terms     KeywordMappingTerm[]
  targets   KeywordMappingTarget[]

  @@index([enabled, id], map: "keyword_mappings_enabled_id_idx")
  @@map("keyword_mappings")
}

model KeywordMappingTerm {
  id             String         @id @db.Uuid
  mappingId      String         @map("mapping_id") @db.Uuid
  term           String
  normalizedTerm String         @unique(map: "keyword_mapping_terms_normalized_term_key") @map("normalized_term")
  kind           String
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  mapping        KeywordMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "keyword_mapping_terms_mapping_id_fkey")

  @@unique([mappingId], where: raw("\"kind\" = 'primary'"), map: "keyword_mapping_terms_primary_key")
  @@index([normalizedTerm(ops: raw("gin_trgm_ops"))], type: Gin, map: "keyword_mapping_terms_normalized_term_trgm_idx")
  @@index([mappingId, kind, id], map: "keyword_mapping_terms_mapping_kind_idx")
  @@map("keyword_mapping_terms")
}

model KeywordMappingTarget {
  id            String         @id @db.Uuid
  mappingId     String         @map("mapping_id") @db.Uuid
  targetKind    String         @map("target_kind")
  categoryId    String?        @map("category_id") @db.Uuid
  subcategoryId String?        @map("subcategory_id") @db.Uuid
  productTag    String?        @map("product_tag")
  mapping       KeywordMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "keyword_mapping_targets_mapping_id_fkey")
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "keyword_mapping_targets_category_id_fkey")
  subcategory   Subcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "keyword_mapping_targets_subcategory_id_fkey")

  @@unique([mappingId, categoryId], where: raw("\"category_id\" IS NOT NULL"), map: "keyword_mapping_targets_category_key")
  @@unique([mappingId, subcategoryId], where: raw("\"subcategory_id\" IS NOT NULL"), map: "keyword_mapping_targets_subcategory_key")
  @@unique([mappingId, productTag], where: raw("\"product_tag\" IS NOT NULL"), map: "keyword_mapping_targets_product_tag_key")
  @@index([categoryId], where: raw("\"category_id\" IS NOT NULL"), map: "keyword_mapping_targets_category_idx")
  @@index([subcategoryId], where: raw("\"subcategory_id\" IS NOT NULL"), map: "keyword_mapping_targets_subcategory_idx")
  @@index([productTag], where: raw("\"product_tag\" IS NOT NULL"), map: "keyword_mapping_targets_product_tag_idx")
  @@map("keyword_mapping_targets")
}
