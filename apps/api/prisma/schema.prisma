// reporting-v1 visible-detail measurement: transient dedup claims (removed
// after 48 hours) and IST daily aggregates without visitor identity.
model BusinessViewDedup {
  sessionSubjectHash Bytes    @map("session_subject_hash")
  windowStart        DateTime @map("window_start") @db.Timestamptz(6)
  businessId         String   @map("business_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "business_view_dedup_business_id_fkey")

  @@id([sessionSubjectHash, windowStart, businessId], map: "business_view_dedup_pkey")
  @@index([createdAt], map: "business_view_dedup_created_at_idx")
  @@map("business_view_dedup")
}

model BusinessDailyViews {
  businessId String   @map("business_id") @db.Uuid
  istDate    DateTime @map("ist_date") @db.Date
  views      BigInt   @default(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "business_daily_views_business_id_fkey")

  @@id([businessId, istDate], map: "business_daily_views_pkey")
  @@map("business_daily_views")
}

// Known reporting-v1 counter start (Admin "Reporting definitions"); earlier
// days are unavailable, never zero.
model BusinessReportingCoverage {
  metric    String   @id(map: "business_reporting_coverage_pkey")
  startedAt DateTime @map("started_at") @db.Timestamptz(6)

  @@map("business_reporting_coverage")
}
