  author        User     @relation(fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "video_comments_author_user_id_fkey")

  @@index([videoId, status, createdAt(sort: Desc), id(sort: Desc)], map: "video_comments_video_status_page_idx")
  @@index([status, createdAt, id], map: "video_comments_status_page_idx")
  @@map("video_comments")
}

model MediaReport {
  id                 String      @id @db.Uuid
  targetKind         String      @map("target_kind")
  assetId            String?     @map("asset_id") @db.Uuid
  videoId            String?     @map("video_id") @db.Uuid
  businessId         String      @map("business_id") @db.Uuid
  placementType      String?     @map("placement_type")
  placementId        String?     @map("placement_id") @db.Uuid
  reporterUserId     String?     @map("reporter_user_id") @db.Uuid
  reporterSubjectHash Bytes      @map("reporter_subject_hash")
  reason             String
  details            String?
  status             String      @default("open")
  resolution         String?
  resolvedAt         DateTime?   @map("resolved_at") @db.Timestamptz(6)
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  asset              MediaAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "media_reports_asset_id_fkey")
  video              Video?      @relation(fields: [videoId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "media_reports_video_id_fkey")
  business           Business    @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "media_reports_business_id_fkey")
  reporter           User?       @relation("MediaReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "media_reports_reporter_user_id_fkey")

  @@index([businessId, status, createdAt, id], map: "media_reports_business_status_page_idx")
  @@index([assetId, status], map: "media_reports_asset_status_idx")
  @@index([videoId, status], map: "media_reports_video_status_idx")
  @@map("media_reports")
}

model BusinessCategory {
  businessId String   @map("business_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "business_categories_business_id_fkey")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "business_categories_category_id_fkey")

  @@id([businessId, categoryId], map: "business_categories_pkey")
  @@unique([businessId], where: raw("\"is_primary\""), map: "business_categories_primary_key")
  @@index([categoryId, businessId], map: "business_categories_category_idx")
  @@map("business_categories")
}

model BusinessHours {
