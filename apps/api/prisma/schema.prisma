  reviewedAt              DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason         String?      @map("rejection_reason")
  subcategoryId           String?      @map("subcategory_id") @db.Uuid
  mergedIntoSubcategoryId String?      @map("merged_into_subcategory_id") @db.Uuid
  version                 Int          @default(1)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  submitter               User         @relation("SuggestionSubmitter", fields: [submitterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_submitter_user_id_fkey")
  reviewer                User?        @relation("SuggestionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_reviewed_by_fkey")
  city                    City         @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_city_id_fkey")
  area                    Area         @relation(fields: [areaId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_area_city_fkey")
  category                Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_category_id_fkey")
  subcategory             Subcategory? @relation("SuggestionApproved", fields: [subcategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_subcategory_id_fkey")
  mergedInto              Subcategory? @relation("SuggestionMerged", fields: [mergedIntoSubcategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_merged_into_fkey")
  business                Business     @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subcategory_suggestions_business_id_fkey")

  @@unique([categoryId, normalizedName], where: raw("\"status\" = 'pending'"), map: "subcategory_suggestions_pending_name_key")
  @@index([status, cityId, areaId, createdAt, id], map: "subcategory_suggestions_queue_idx")
  @@index([businessId, createdAt(sort: Desc), id(sort: Desc)], map: "subcategory_suggestions_business_idx")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "subcategory_suggestions_normalized_name_trgm_idx")
  @@index([areaId, cityId], map: "subcategory_suggestions_area_city_idx")
  @@map("subcategory_suggestions")
}

model KeywordMapping {
  id        String                 @id @db.Uuid
  enabled   Boolean                @default(true)
  version   Int                    @default(1)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  terms     KeywordMappingTerm[]
  targets   KeywordMappingTarget[]

  @@index([enabled, id], map: "keyword_mappings_enabled_id_idx")
  @@map("keyword_mappings")
}

model KeywordMappingTerm {
  id             String         @id @db.Uuid
  mappingId      String         @map("mapping_id") @db.Uuid
  term           String
  normalizedTerm String         @unique(map: "keyword_mapping_terms_normalized_term_key") @map("normalized_term")
  kind           String
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  mapping        KeywordMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "keyword_mapping_terms_mapping_id_fkey")

  @@unique([mappingId], where: raw("\"kind\" = 'primary'"), map: "keyword_mapping_terms_primary_key")
  @@index([normalizedTerm(ops: raw("gin_trgm_ops"))], type: Gin, map: "keyword_mapping_terms_normalized_term_trgm_idx")
  @@index([mappingId, kind, id], map: "keyword_mapping_terms_mapping_kind_idx")
  @@map("keyword_mapping_terms")
}

model KeywordMappingTarget {
  id            String         @id @db.Uuid
  mappingId     String         @map("mapping_id") @db.Uuid
  targetKind    String         @map("target_kind")
  categoryId    String?        @map("category_id") @db.Uuid
  subcategoryId String?        @map("subcategory_id") @db.Uuid
  productTag    String?        @map("product_tag")
  mapping       KeywordMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "keyword_mapping_targets_mapping_id_fkey")
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "keyword_mapping_targets_category_id_fkey")
  subcategory   Subcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "keyword_mapping_targets_subcategory_id_fkey")

  @@unique([mappingId, categoryId], where: raw("\"category_id\" IS NOT NULL"), map: "keyword_mapping_targets_category_key")
  @@unique([mappingId, subcategoryId], where: raw("\"subcategory_id\" IS NOT NULL"), map: "keyword_mapping_targets_subcategory_key")
  @@unique([mappingId, productTag], where: raw("\"product_tag\" IS NOT NULL"), map: "keyword_mapping_targets_product_tag_key")
  @@index([categoryId], where: raw("\"category_id\" IS NOT NULL"), map: "keyword_mapping_targets_category_idx")
  @@index([subcategoryId], where: raw("\"subcategory_id\" IS NOT NULL"), map: "keyword_mapping_targets_subcategory_idx")
  @@index([productTag], where: raw("\"product_tag\" IS NOT NULL"), map: "keyword_mapping_targets_product_tag_idx")
  @@map("keyword_mapping_targets")
}

// Businesses (F-PF/F-VD/F-PV). `logo_asset_id`, `cover_asset_id` and
// `business_documents.asset_id` gain their media_assets FKs in the Media
// migration; there is no Prisma relation until then.
model Business {
  products Product[]
  services Service[]
  reviews Review[]
  offers Offer[]
  billingPurchases BillingPurchase[]
  subscriptions BusinessSubscription[]
  subscriptionVersion BusinessSubscriptionVersion?
  promotionPlacements PromotionPlacement[]
  id             String                                @id @db.Uuid
  ownerUserId    String                                @map("owner_user_id") @db.Uuid
  kind           String
  status         String                                @default("draft")
  nameEn         String?                               @map("name_en")
  nameHi         String?                               @map("name_hi")
  slug           String?                               @unique(map: "businesses_slug_key")
  description    String?
  cityId         String?                               @map("city_id") @db.Uuid
  areaId         String?                               @map("area_id") @db.Uuid
  addressText    String?                               @map("address_text")
  location       Unsupported("geography(Point,4326)")?
  phoneE164      String                                @map("phone_e164")
  whatsappE164   String?                               @map("whatsapp_e164")
  email          String?
  instagramUrl   String?                               @map("instagram_url")
  youtubeUrl     String?                               @map("youtube_url")
  facebookUrl    String?                               @map("facebook_url")
  logoAssetId    String?                               @map("logo_asset_id") @db.Uuid
  coverAssetId   String?                               @map("cover_asset_id") @db.Uuid
  verifiedAt     DateTime?                             @map("verified_at") @db.Timestamptz(6)
  submittedAt    DateTime?                             @map("submitted_at") @db.Timestamptz(6)
  reviewReason   String?                               @map("review_reason")
  reviewedBy     String?                               @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?                             @map("reviewed_at") @db.Timestamptz(6)
  version        Int                                   @default(1)
  deletedAt      DateTime?                             @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                              @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner          User                                  @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "businesses_owner_user_id_fkey")
  reviewer       User?                                 @relation("BusinessReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "businesses_reviewed_by_fkey")
  area           Area?                                 @relation(fields: [areaId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: Restrict, map: "businesses_area_city_fkey")
  categories     BusinessCategory[]
  hours          BusinessHours[]
  settings       BusinessSettings?
  documents      BusinessDocument[]
  billingProfile BusinessBillingProfile?
  viewDedup      BusinessViewDedup[]
  dailyViews     BusinessDailyViews[]
  suggestions    SubcategorySuggestion[]
  videos         Video[]
  mediaReports   MediaReport[]
  follows        Follow[]

  @@unique([ownerUserId, kind], map: "businesses_owner_kind_key")
  @@index([ownerUserId, status], map: "businesses_owner_status_idx")
  @@index([status, areaId, createdAt, id], map: "businesses_queue_idx")
  @@index([kind, createdAt, id], where: raw("status = 'approved' AND deleted_at IS NULL AND name_en IS NOT NULL AND slug IS NOT NULL"), map: "businesses_discovery_page_idx")
  @@index([kind, createdAt, id], where: raw("status = 'approved' AND deleted_at IS NULL AND name_en IS NOT NULL AND slug IS NOT NULL AND verified_at IS NOT NULL"), map: "businesses_discovery_verified_page_idx")
  @@index([areaId, cityId], map: "businesses_area_city_idx")
  @@index([location], type: Gist, map: "businesses_location_gist_idx")
  @@map("businesses")
}

model Video {
  id                 String    @id @db.Uuid
  businessId         String    @map("business_id") @db.Uuid
  source             String
  providerKind       String    @map("provider_kind")
  providerVideoId    String    @map("provider_video_id")
  caption            String    @default("")
  hashtags           String[]  @default([])
  showInGallery      Boolean   @default(false) @map("show_in_gallery")
  showInReels         Boolean   @default(false) @map("show_in_reels")
  status             String    @default("pending")
  decisionReason     String?   @map("decision_reason")
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(6)
  ownerDeletedAt     DateTime? @map("owner_deleted_at") @db.Timestamptz(6)
  sortOrder          Int       @default(0) @map("sort_order")
  viewCount          BigInt    @default(0) @map("view_count")
  likeCount          BigInt    @default(0) @map("like_count")
  commentCount       BigInt    @default(0) @map("comment_count")
  shareCount         BigInt    @default(0) @map("share_count")
  engagementVersion  BigInt    @default(0) @map("engagement_version")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "videos_business_id_fkey")
  reports            MediaReport[]
  comments           VideoComment[]
  likes              Like[]
  engagementCounts   VideoEngagementCounts?

  @@index([status, showInReels, id], map: "videos_public_candidates_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "videos_moderation_page_idx")
  @@index([businessId, createdAt(sort: Desc), id(sort: Desc)], map: "videos_business_page_idx")
  @@index([businessId, sortOrder, id], map: "videos_business_order_idx")
  @@map("videos")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "likes_user_id_fkey")
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "likes_video_id_fkey")

  @@id([userId, videoId], map: "likes_pkey")
  @@index([videoId], map: "likes_video_id_idx")
  @@map("likes")
}

model Heart {
  userId     String   @map("user_id") @db.Uuid
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  mediaKind  String?  @map("media_kind")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "hearts_user_id_fkey")

  @@id([userId, targetType, targetId], map: "hearts_pkey")
  @@index([userId, createdAt(sort: Desc), targetId], map: "hearts_user_created_target_idx")
  @@index([userId, targetType, createdAt(sort: Desc), targetId(sort: Desc)], map: "hearts_saved_page_idx")
  @@index([userId, targetType, mediaKind, createdAt(sort: Desc), targetId(sort: Desc)], map: "hearts_saved_kind_page_idx")
  @@map("hearts")
}

model Follow {
  userId         String    @map("user_id") @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  bellOn         Boolean   @default(false) @map("bell_on")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastFollowedAt DateTime  @default(now()) @map("last_followed_at") @db.Timestamptz(6)
  unfollowedAt   DateTime? @map("unfollowed_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "follows_user_id_fkey")
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "follows_business_id_fkey")

  @@id([userId, businessId], map: "follows_pkey")
  @@index([businessId, userId], where: raw("\"unfollowed_at\" IS NULL"), map: "follows_business_user_active_idx")
  @@index([userId], where: raw("\"unfollowed_at\" IS NULL"), map: "follows_user_active_idx")
  @@index([userId, lastFollowedAt(sort: Desc), businessId(sort: Desc)], where: raw("\"unfollowed_at\" IS NULL"), map: "follows_saved_page_idx")
  @@map("follows")
}

model VideoEngagementCounts {
  videoId   String   @id @map("video_id") @db.Uuid
  likeCount BigInt   @default(0) @map("like_count")
  shareCount BigInt  @default(0) @map("share_count")
  version   BigInt   @default(1)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "video_engagement_counts_video_id_fkey")

  @@map("video_engagement_counts")
}

model ReelRankSnapshot {
