/// Delivery rider application/profile (20261113060000). SQL owns the status,
/// vehicle, online-implies-approved and submitted-field checks.
model RiderProfile {
  userId               String                                @id @map("user_id") @db.Uuid
  cityId               String?                               @map("city_id") @db.Uuid
  areaId               String?                               @map("area_id") @db.Uuid
  fullName             String?                               @map("full_name")
  vehicleType          String?                               @map("vehicle_type")
  vehicleNumber        String?                               @map("vehicle_number")
  /// AES-GCM ciphertext (API PII key); never plaintext.
  payoutUpiCiphertext  String?                               @map("payout_upi_ciphertext")
  payoutBankCiphertext String?                               @map("payout_bank_ciphertext")
  status               String                                @default("draft")
  decisionReason       String?                               @map("decision_reason")
  requirementsVersion  String?                               @map("requirements_version")
  submittedAt          DateTime?                             @map("submitted_at") @db.Timestamptz(6)
  isOnline             Boolean                               @default(false) @map("is_online")
  lastLocation         Unsupported("geography(Point,4326)")? @map("last_location")
  lastLocationAt       DateTime?                             @map("last_location_at") @db.Timestamptz(6)
  preferredLocale      String                                @default("en") @map("preferred_locale")
  version              Int                                   @default(1)
  createdAt            DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                              @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                 User                                  @relation("RiderProfileUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "rider_profiles_user_id_fkey")
  city                 City?                                 @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "rider_profiles_city_id_fkey")
  area                 Area?                                 @relation(fields: [areaId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: Restrict, map: "rider_profiles_area_city_fkey")
  documents            RiderDocument[]

  @@index([lastLocation], type: Gist, where: raw("is_online AND status = 'approved'"), map: "rider_profiles_online_location_gist_idx")
  @@index([cityId, areaId, status, createdAt, userId], map: "rider_profiles_scope_queue_idx")
  @@index([status, createdAt, userId], map: "rider_profiles_status_queue_idx")
  @@index([areaId, cityId], map: "rider_profiles_area_city_idx")
  @@map("rider_profiles")
}

