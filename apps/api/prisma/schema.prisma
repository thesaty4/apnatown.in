  @@unique([notificationId, channel], map: "notification_deliveries_message_channel_key")
  @@unique([campaignId, recipientKey], where: raw("\"campaign_id\" IS NOT NULL"), map: "notification_deliveries_campaign_recipient_idx")
  @@unique([channel, providerMessageId], where: raw("\"provider_message_id\" IS NOT NULL"), map: "notification_deliveries_provider_message_idx")
  @@index([status, nextAttemptAt, leaseUntil], map: "notification_deliveries_work_idx")
  @@map("notification_deliveries")
}

