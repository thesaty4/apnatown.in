/// Notifications-owned role-bound logical messages (F-NT-001, F-X-012). Feed
/// shows published in-app items only; params never carry codes/phones/PII.
model Notification {
  id               String                 @id(map: "notifications_pkey") @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  audienceRole     String                 @map("audience_role")
  category         String
  topic            String
  intent           String
  templateKey      String                 @map("template_key")
  templateVersion  Int                    @map("template_version")
  contentVersion   String                 @map("content_version")
  params           Json                   @default("{}")
  contentRef       Json?                  @map("content_ref")
  followerRef      Json?                  @map("follower_ref")
  linkPath         String?                @map("link_path")
  resourceScope    Json?                  @map("resource_scope")
  inAppPublishedAt DateTime?              @map("in_app_published_at") @db.Timestamptz(6)
  readAt           DateTime?              @map("read_at") @db.Timestamptz(6)
  sourceEventId    String                 @map("source_event_id") @db.Uuid
  sourceType       String                 @map("source_type")
  sourceVersion    BigInt                 @map("source_version")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "notifications_user_id_fkey")
  deliveries       NotificationDelivery[]

  @@unique([userId, audienceRole, sourceEventId, templateKey, contentVersion], map: "notifications_logical_message_key")
  @@index([userId, audienceRole, inAppPublishedAt(sort: Desc), id(sort: Desc)], where: raw("\"in_app_published_at\" IS NOT NULL"), map: "notifications_feed_idx")
  @@index([userId, audienceRole], where: raw("\"in_app_published_at\" IS NOT NULL AND \"read_at\" IS NULL"), map: "notifications_unread_idx")
  @@map("notifications")
}

