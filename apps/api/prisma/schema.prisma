generator client {
  provider        = "prisma-client"
  output          = "../src/shared/persistence/generated"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model OutboxEvent {
  id               String    @id @db.Uuid
  type             String
  schemaVersion    Int       @default(1) @map("schema_version")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  payload          Json      @db.JsonB
  correlationId    String    @map("correlation_id")
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  availableAt      DateTime  @map("available_at") @db.Timestamptz(6)
  state            String    @default("pending")
  attemptCount     Int       @default(0) @map("attempt_count")
  leaseOwner       String?   @map("lease_owner")
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  lastErrorCode    String?   @map("last_error_code")

  @@index([state, availableAt, id], map: "outbox_events_state_available_at_id_idx")
  @@index([leaseExpiresAt, id], where: raw("\"state\" = 'publishing'"), map: "outbox_events_lease_expires_at_id_idx")
  @@index([aggregateType, aggregateId, aggregateVersion], map: "outbox_events_aggregate_idx")
  @@map("outbox_events")
}

model IdempotencyKey {
  id              String    @id @db.Uuid
  principalKey    String    @map("principal_key")
  operation       String
  keyHash         Bytes     @map("key_hash")
  requestHash     Bytes     @map("request_hash")
  state           String
  leaseOwner      String?   @map("lease_owner")
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  httpStatus      Int?      @map("http_status")
  responseBody    Json?     @map("response_body") @db.JsonB
  responseHeaders Json      @default("{}") @map("response_headers") @db.JsonB
  resourceRef     Json?     @map("resource_ref") @db.JsonB
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)

  @@unique([principalKey, operation, keyHash], map: "idempotency_keys_principal_operation_key_hash_key")
  @@index([expiresAt, id], map: "idempotency_keys_expires_at_id_idx")
  @@index([state, leaseExpiresAt], map: "idempotency_keys_state_lease_expires_at_idx")
  @@map("idempotency_keys")
}

model RateLimitBucket {
  policyKey   String   @map("policy_key")
  subjectHash Bytes    @map("subject_hash")
  bucketStart DateTime @map("bucket_start") @db.Timestamptz(6)
  hitCount    BigInt   @default(0) @map("hit_count")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([policyKey, subjectHash, bucketStart])
  @@index([expiresAt], map: "rate_limit_buckets_expires_at_idx")
  @@map("rate_limit_buckets")
}

model User {
  id              String     @id @db.Uuid
  phoneCiphertext String?    @map("phone_ciphertext")
  phoneLookupHash Bytes?     @unique(map: "users_phone_lookup_hash_key") @map("phone_lookup_hash")
  emailCiphertext String?    @map("email_ciphertext")
  displayName     String?    @map("display_name")
  preferredLocale String     @default("en") @map("preferred_locale")
  themePreference String     @default("light") @map("theme_preference")
  accountStatus   String     @default("active") @map("account_status")
  version         Int        @default(1)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime   @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @map("updated_at") @db.Timestamptz(6)
  roles           UserRole[]
  sessions        Session[]
  addresses       Address[]

  @@index([deletedAt], where: raw("\"deleted_at\" IS NULL"), map: "users_active_deleted_at_idx")
  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "user_roles_user_id_fkey")

  @@id([userId, role], map: "user_roles_pkey")
  @@index([role, userId], map: "user_roles_role_user_id_idx")
  @@map("user_roles")
}

model Address {
  id          String                                @id @db.Uuid
  userId      String                                @map("user_id") @db.Uuid
  label       String
  addressText String                                @map("address_text")
  landmark    String?
  pinCode     String                                @map("pin_code")
  cityId      String                                @map("city_id") @db.Uuid
  areaId      String?                               @map("area_id") @db.Uuid
  location    Unsupported("geography(Point,4326)")?
  isDefault   Boolean                               @default(false) @map("is_default")
  version     Int                                   @default(1)
  deletedAt   DateTime?                             @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime                              @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                              @map("updated_at") @db.Timestamptz(6)
  user        User                                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "addresses_user_id_fkey")
  city        City                                  @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "addresses_city_id_fkey")
  area        Area?                                 @relation(fields: [areaId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: Restrict, map: "addresses_area_city_fkey")

  @@unique([userId], where: raw("\"is_default\" AND \"deleted_at\" IS NULL"), map: "addresses_live_default_key")
  @@index([userId, deletedAt, createdAt(sort: Desc), id(sort: Desc)], map: "addresses_owner_page_idx")
  @@index([cityId], map: "addresses_city_id_idx")
  @@index([areaId, cityId], map: "addresses_area_city_idx")
  @@map("addresses")
}

model OtpChallenge {
  id              String    @id @db.Uuid
  phoneCiphertext String    @map("phone_ciphertext")
  phoneLookupHash Bytes     @map("phone_lookup_hash")
  codeHash        String    @map("code_hash")
  attemptCount    Int       @default(0) @map("attempt_count")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  resendAfter     DateTime  @map("resend_after") @db.Timestamptz(6)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  supersededAt    DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)

  @@index([phoneLookupHash, createdAt(sort: Desc)], map: "otp_challenges_phone_created_at_idx")
  @@index([expiresAt], map: "otp_challenges_expires_at_idx")
  @@map("otp_challenges")
}

model Session {
  id         String    @id @db.Uuid
  kind       String
  userId     String?   @map("user_id") @db.Uuid
  tokenHash  Bytes     @unique(map: "sessions_token_hash_key") @map("token_hash")
  csrfToken  String    @map("csrf_token")
  createdAt  DateTime  @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(6)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sessions_user_id_fkey")

  @@index([userId, revokedAt, expiresAt], map: "sessions_user_revoked_expires_at_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model City {
  id        String                @id @db.Uuid
  slug      String                @unique(map: "cities_slug_key")
  nameEn    String                @map("name_en")
  nameHi    String                @map("name_hi")
  stateCode String                @map("state_code") @db.Char(2)
  status    String
  version   Int                   @default(1)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  areas     Area[]
  zones     Zone[]
  waitlist  ServiceAreaWaitlist[]
  addresses Address[]

  @@index([status, nameEn, id], map: "cities_status_name_en_id_idx")
  @@map("cities")
}

model Area {
  id        String                                @id @db.Uuid
  cityId    String                                @map("city_id") @db.Uuid
  slug      String
  nameEn    String                                @map("name_en")
  nameHi    String                                @map("name_hi")
  pinCode   String?                               @map("pin_code")
  centroid  Unsupported("geography(Point,4326)")?
  createdAt DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                              @default(now()) @map("updated_at") @db.Timestamptz(6)
  city      City                                  @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "areas_city_id_fkey")
  addresses Address[]

  @@unique([id, cityId], map: "areas_id_city_id_key")
  @@unique([cityId, slug], map: "areas_city_slug_key")
  @@index([cityId, nameEn, id], map: "areas_city_name_en_id_idx")
  @@index([cityId, pinCode], map: "areas_city_pin_code_idx")
  @@index([nameEn(ops: raw("gin_trgm_ops")), nameHi(ops: raw("gin_trgm_ops"))], type: Gin, map: "areas_names_trgm_idx")
  @@map("areas")
}

model Zone {
  id        String                                @id @db.Uuid
  cityId    String                                @map("city_id") @db.Uuid
  name      String
  polygon   Unsupported("geometry(Polygon,4326)")
  status    String
  version   Int                                   @default(1)
  createdAt DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                              @default(now()) @map("updated_at") @db.Timestamptz(6)
  city      City                                  @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "zones_city_id_fkey")
  feeSlabs  ZoneFeeSlab[]

  @@index([polygon], type: Gist, map: "zones_polygon_idx")
  @@index([cityId, status], map: "zones_city_status_idx")
  @@map("zones")
}

model ZoneFeeSlab {
  zoneId          String   @map("zone_id") @db.Uuid
  sequence        Int      @db.SmallInt
  upperDistanceKm Decimal  @map("upper_distance_km") @db.Decimal(5, 2)
  feePaise        BigInt   @map("fee_paise")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  zone            Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "zone_fee_slabs_zone_id_fkey")

  @@id([zoneId, sequence], map: "zone_fee_slabs_pkey")
  @@unique([zoneId, upperDistanceKm], map: "zone_fee_slabs_zone_distance_key")
  @@map("zone_fee_slabs")
}

model ServiceAreaWaitlist {
  id              String   @id @db.Uuid
  cityId          String?  @map("city_id") @db.Uuid
  phoneCiphertext String   @map("phone_ciphertext")
  phoneLookupHash Bytes    @map("phone_lookup_hash")
  requestedAt     DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  city            City?    @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "service_area_waitlist_city_id_fkey")

  @@index([cityId, requestedAt(sort: Desc)], map: "service_area_waitlist_city_requested_at_idx")
  @@map("service_area_waitlist")
}
