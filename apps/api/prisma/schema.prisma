// Businesses (F-PF/F-VD/F-PV). `logo_asset_id`, `cover_asset_id` and
// `business_documents.asset_id` gain their media_assets FKs in the Media
// migration; there is no Prisma relation until then.
model Business {
  products Product[]
  services Service[]
  reviews Review[]
  offers Offer[]
  billingPurchases BillingPurchase[]
  subscriptions BusinessSubscription[]
  subscriptionVersion BusinessSubscriptionVersion?
  promotionPlacements PromotionPlacement[]
  id             String                                @id @db.Uuid
  ownerUserId    String                                @map("owner_user_id") @db.Uuid
  kind           String
  status         String                                @default("draft")
  nameEn         String?                               @map("name_en")
  nameHi         String?                               @map("name_hi")
  slug           String?                               @unique(map: "businesses_slug_key")
  description    String?
  cityId         String?                               @map("city_id") @db.Uuid
  areaId         String?                               @map("area_id") @db.Uuid
  addressText    String?                               @map("address_text")
  location       Unsupported("geography(Point,4326)")?
  phoneE164      String                                @map("phone_e164")
  whatsappE164   String?                               @map("whatsapp_e164")
  email          String?
  instagramUrl   String?                               @map("instagram_url")
  youtubeUrl     String?                               @map("youtube_url")
  facebookUrl    String?                               @map("facebook_url")
  logoAssetId    String?                               @map("logo_asset_id") @db.Uuid
  coverAssetId   String?                               @map("cover_asset_id") @db.Uuid
  verifiedAt     DateTime?                             @map("verified_at") @db.Timestamptz(6)
  submittedAt    DateTime?                             @map("submitted_at") @db.Timestamptz(6)
  reviewReason   String?                               @map("review_reason")
  reviewedBy     String?                               @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?                             @map("reviewed_at") @db.Timestamptz(6)
  version        Int                                   @default(1)
  deletedAt      DateTime?                             @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                              @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner          User                                  @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "businesses_owner_user_id_fkey")
  reviewer       User?                                 @relation("BusinessReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "businesses_reviewed_by_fkey")
  area           Area?                                 @relation(fields: [areaId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: Restrict, map: "businesses_area_city_fkey")
  categories     BusinessCategory[]
  hours          BusinessHours[]
  settings       BusinessSettings?
  documents      BusinessDocument[]
  billingProfile BusinessBillingProfile?
  viewDedup      BusinessViewDedup[]
  dailyViews     BusinessDailyViews[]
  suggestions    SubcategorySuggestion[]
  videos         Video[]
  mediaReports   MediaReport[]
  follows        Follow[]
  providerExpertise        ProviderExpertise[]
  productCategoryPills     ProductCategoryPill[]
  providerExpertiseVersion ProviderExpertiseVersion?
  enquiries                Enquiry[]

  @@unique([ownerUserId, kind], map: "businesses_owner_kind_key")
  @@index([ownerUserId, status], map: "businesses_owner_status_idx")
  @@index([status, areaId, createdAt, id], map: "businesses_queue_idx")
  @@index([kind, createdAt, id], where: raw("status = 'approved' AND deleted_at IS NULL AND name_en IS NOT NULL AND slug IS NOT NULL"), map: "businesses_discovery_page_idx")
  @@index([kind, createdAt, id], where: raw("status = 'approved' AND deleted_at IS NULL AND name_en IS NOT NULL AND slug IS NOT NULL AND verified_at IS NOT NULL"), map: "businesses_discovery_verified_page_idx")
  @@index([areaId, cityId], map: "businesses_area_city_idx")
  @@index([location], type: Gist, map: "businesses_location_gist_idx")
  @@map("businesses")
}

model Video {
  id                 String    @id @db.Uuid
  businessId         String    @map("business_id") @db.Uuid
  source             String
  providerKind       String    @map("provider_kind")
  providerVideoId    String    @map("provider_video_id")
  caption            String    @default("")
  hashtags           String[]  @default([])
  showInGallery      Boolean   @default(false) @map("show_in_gallery")
  showInReels         Boolean   @default(false) @map("show_in_reels")
  status             String    @default("pending")
  decisionReason     String?   @map("decision_reason")
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(6)
  ownerDeletedAt     DateTime? @map("owner_deleted_at") @db.Timestamptz(6)
  sortOrder          Int       @default(0) @map("sort_order")
  viewCount          BigInt    @default(0) @map("view_count")
  likeCount          BigInt    @default(0) @map("like_count")
  commentCount       BigInt    @default(0) @map("comment_count")
  shareCount         BigInt    @default(0) @map("share_count")
  engagementVersion  BigInt    @default(0) @map("engagement_version")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// FK media_assets(id) in SQL (20261112253000); own `video_thumbnail` asset.
  thumbnailAssetId   String?   @map("thumbnail_asset_id") @db.Uuid
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "videos_business_id_fkey")
  reports            MediaReport[]
  comments           VideoComment[]
  likes              Like[]
  engagementCounts   VideoEngagementCounts?
  links              VideoLink[]

  @@index([status, showInReels, id], map: "videos_public_candidates_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "videos_moderation_page_idx")
  @@index([businessId, createdAt(sort: Desc), id(sort: Desc)], map: "videos_business_page_idx")
  @@index([businessId, sortOrder, id], map: "videos_business_order_idx")
  @@index([thumbnailAssetId], where: raw("thumbnail_asset_id IS NOT NULL"), map: "videos_thumbnail_asset_idx")
  @@map("videos")
}

model VideoLink {
  videoId    String @map("video_id") @db.Uuid
  targetType String @map("target_type")
  targetId   String @map("target_id") @db.Uuid
