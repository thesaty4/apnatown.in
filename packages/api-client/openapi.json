  "components": {
    "schemas": {
      "ErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "message_key": {
            "type": "string",
            "pattern": "^errors\\.[A-Za-z0-9.]+$"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "details": {
            "type": "object",
            "properties": {
              "fields": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 100
                }
              }
            },
            "additionalProperties": false
          },
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "code",
          "message_key",
          "status",
          "details",
          "correlationId"
        ],
        "additionalProperties": false
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    }
